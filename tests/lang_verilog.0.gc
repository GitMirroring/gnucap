
verilog

resistor #(.r(1))     Rin2 (\a , \b );
resistor #(.r(1))     Rin2 (\a , \b	); // tab
resistor #(.r(1))     Rin2 (\a*a , \-- );
resistor #(.r(1))     Rin2 (\$aa , \\\ );

list

spice

.list
.clear
.simulator lang=verilog

resistor #(.r(10*(1-gain))) Rin1 (in amp_in);
resistor #(.r(10*gain))     Rin2 (amp_in 0);

simulator lang=spice insensitive=no
Vcc (V_cc 0) dc 20
Vin (in 0) ac .2
.simulator lang=verilog

parameter gain=.5;
print op v(V_cc) v(in) v(out) iter(0)
op

print tran v(V_cc) v(in) v(out) iter(0)
tran 1
