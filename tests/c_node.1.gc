verilog
load ./c_dbg_disc.so
options trace

discipline disc1;
enddiscipline
discipline disc2;
enddiscipline
discipline disc2;
enddiscipline

connectmodule cm2(out, in);
output out;
input in;
endmodule

connectrules foo;
	connect a b resolveto c;
	connect cm0;
	connect cm1 merged;
	connect cm2 split;
endconnectrules

list
`disciplines

delete disc2
`disciplines

delete disc2
`disciplines
