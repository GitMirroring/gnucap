  (* S0_x_p=0,  S0_y_p=0, S0_x_n=24, S0_y_p=7 *) resistor #(.r(1k))      r1 (.p(a1), .n(b1));
  (* S0_x_p=24, S0_y_p=7, S0_x2=25, S0_y2=-3 *)  resistor #(.r(1k))      r2 (.p(b2), .n(c2));
