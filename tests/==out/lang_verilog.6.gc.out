module a (.b(b),.c(c),.d(d),.e(e),.f(f),.g(g));
  resistor #(1k) r1 (b, c);
  resistor #(1k) r2 (c, d);
  resistor #(1k) r3 (e, f);
  resistor #(1k) r4 (f, g);
endmodule // a

ground gnd;
vsource #(.dc(4)) v1 (.p(b),.n(gnd));
a #() x1 (.b(b),.c(c),.d(d),.e(d),.f(f),.g(gnd));
#           v(b)       v(c)       v(d)       v(f)       v(gnd)    
