module Switch (1,2);
vsource #(pulse.iv(2*init), .pv(2-6*init), .delay(NA( 0.)), .rise(2*time), .fall(NA( 0.)), .width(NA( Inf)), .period(NA( Inf))) V1 (.p(c),.n(0));
paramset sss sw;\
 .vt=0; .vh=1; .von=NA( 0.); .voff=NA( 0.); .ron=Ron+1e-10; .roff=Roff; .tnom=NA( NA);\
endparmset

sss #() S1 (.p(1),.n(2),.ps(c),.ns(0));
endmodule // Switch

module Vdc (p,n);
vsource #(.dc(U)) v (.p(p),.n(n));
endmodule // Vdc

