module BJT (b,c,e,s);
paramset mypnp pnp;\
 .level=1; .kf=Kf; .af=Af; .bf=Bf; .br=Br; .is=Is; .nf=Nf; .nr=Nr; .vaf=Vaf; .var=Var; .isc=Isc; .c4=NA( 0.); .nc=Nc; .ise=Ise; .c2=NA( 0.); .ne=Ne; .ikf=Ikf; .ikr=Ikr; .irb=Irb; .rb=Rb; .rbm=Rbm; .re=Re; .rc=Rc; .cjc=Cjc; .cje=Cje; .cjs=Cjs; .fc=Fc; .mjc=Mjc; .mje=Mje; .mjs=Mjs; .vjc=Vjc; .vje=Vje; .vjs=Vjs; .xcjc=Xcjc; .itf=Itf; .ptf=Ptf; .tf=Tf; .tr=Tr; .vtf=Vtf; .xtf=Xtf; .xtb=Xtb; .xti=Xti; .eg=Eg;\
endparmset

mypnp #(.area(Area*(1.-Type)*.5+1e-20)) p (.c(c),.b(b),.e(e),.s(s));
endmodule // BJT

