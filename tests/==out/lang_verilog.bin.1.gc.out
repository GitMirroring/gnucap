module main (1,2,3,4,5,6,7,8,9);
mypmos #(.w(8e-6),.l(600e-9)) Mp1 (.d(3),.g(2),.s(1),.b(1));
mynmos #(.w(8e-6),.l(600e-9)) Mn1 (.d(3),.g(2),.s(0),.b(0));
mypmos #(.w(8e-6),.l(600e-9)) Mp2 (.d(4),.g(2),.s(1),.b(1));
mynmos #(.w(8e-6),.l(600e-9)) Mn2 (.d(4),.g(2),.s(0),.b(0));
resistor #(.r( 10.K)) R2 (.p(4),.n(0));
mypmos #(.w(8e-6),.l(600e-9)) Mp3 (.d(5),.g(2),.s(1),.b(1));
mynmos #(.w(8e-6),.l(600e-9)) Mn3 (.d(5),.g(2),.s(0),.b(0));
capacitor #(.c( 1.p)) C3 (.p(5),.n(0));
mypmos #(.w(8e-6),.l(600e-9)) Mp4 (.d(6),.g(2),.s(1),.b(1));
resistor #(.r( 5.8K)) R4 (.p(6),.n(0));
mynmos #(.w(8e-6),.l(600e-9)) Mn5 (.d(7),.g(2),.s(0),.b(0));
resistor #(.r( 5.8K)) R5 (.p(7),.n(1));
vsource #(.dc(5.)) vdd (.p(1),.n(0));
endmodule // main

