module m (.a(a),.b(b),.c(c));
  ground \0 ;
  capacitor #(.c(1),.$xposition(2),.$method("euler")) ca (.p(a),.n(\0 ));
  capacitor #(.c(1),.$method("euleronly")) cb (.p(b),.n(\0 ));
  capacitor #(.c(1),.$method("trap")) cc (.p(c),.n(\0 ));
endmodule // m

