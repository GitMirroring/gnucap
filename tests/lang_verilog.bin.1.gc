verilog

// replicate d_mos1.bin2.ckt with verilog
// options log

paramset mynmos nmos1;
 .level=1;
 .vto=0.6;
 .lmax=2e-6;
 .lmin=1e-6;
endparamset

paramset mypmos pmos1;
 .level=1;
 .vto=-0.6;
 .lmax=2e-6;
 .lmin=1e-6;
endparamset

paramset mynmos nmos1;
 .level=1;
 .vto=0.7;
 .lmax=1e-6;
 .lmin=.5e-6;
endparamset

paramset mypmos pmos1;
 .level=1;
 .vto=-0.7;
 .lmax=1e-6;
 .lmin=.5e-6;
endparamset

module main(1 2 3 4 5 6 7 8 9)

mypmos #(.l(600e-9),.w(8e-6)) Mp1 (.d(3),.g(2),.s(1),.b(1));
mynmos #(.l(600e-9),.w(8e-6)) Mn1 (.d(3),.g(2),.s(0),.b(0));
mypmos #(.l(600e-9),.w(8e-6)) Mp2 (.d(4),.g(2),.s(1),.b(1));
mynmos #(.l(600e-9),.w(8e-6)) Mn2 (.d(4),.g(2),.s(0),.b(0));
resistor #(.r( 10.K)) R2 (.p(4),.n(0));
mypmos #(.l(600e-9),.w(8e-6)) Mp3 (.d(5),.g(2),.s(1),.b(1));
mynmos #(.l(600e-9),.w(8e-6)) Mn3 (.d(5),.g(2),.s(0),.b(0));
capacitor #(.c( 1.p)) C3 (.p(5),.n(0));
mypmos #(.l(600e-9),.w(8e-6)) Mp4 (.d(6),.g(2),.s(1),.b(1));
resistor #(.r( 5.8K)) R4 (.p(6),.n(0));
mynmos #(.l(600e-9),.w(8e-6)) Mn5 (.d(7),.g(2),.s(0),.b(0));
resistor #(.r( 5.8K)) R5 (.p(7),.n(1));
vsource #(.dc(5.)) vdd (.p(1),.n(0));

endmodule

main m(1 2 3 4 5 6 7 8 9);

list

spice

vin 2 0 PWL (0 0, 1n 0, 3n 5, 10n 5, 12n 0, 20n 0)

.print dc v(1) v(2) v(3) v(4) v(5) v(6) v(7)
.dc vin 0 5 .25

.print dc gm(m.M*)
.dc vin 0 5 5

.print dc vth(m.M*)
.dc vin 0 5 5

.end
