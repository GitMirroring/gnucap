include ../autotools/common.mk

GNUCAP = LD_LIBRARY_PATH=$(top_builddir)/lib/.libs:$(top_builddir)/apps/.libs $(top_builddir)/main/gnucap

check: gnucap-run

examplesdir = ${docdir}/examples

install-data-local:
	install -d ${DESTDIR}${examplesdir}
	install --mode=664 -t ${DESTDIR}${examplesdir} ${srcdir}/*.ckt ${srcdir}/*.gc

uninstall-local:
	rm -rf ${DESTDIR}${examplesdir}

gnucap-run:
	echo end | $(GNUCAP)

dist-hook:
	cp -r $(srcdir)/*.gc $(srcdir)/*.ckt $(distdir)
	mkdir -p $(distdir)/==out
	cp -r $(srcdir)/==out/*.out $(distdir)/==out

.PHONY: check
