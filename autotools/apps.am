# TODO: fix upstream/Make1 instead.
BUILT_SOURCES = ${GENERATED_SRCS} ${GENERATED_HDRS}
.model.h:
.model.cc:
.cc.o:

%.cc %.h: %.model
	$(AM_V_GEN)$(GNUCAP_MODELGEN) $<
	@touch $*.cc


include ../apps/Make1
include ../autotools/common.mk

plugindir=$(pkglibdir)
plugin_LTLIBRARIES = gnucap-default-plugins.la
AM_LDFLAGS = -shared -module -avoid-version
#------------------------------------------------------------------------
gnucap_default_plugins_la_SOURCES = $(RAW_SRCS) $(MODELS)
gnucap_default_plugins_la_CPPFLAGS = $(AM_CPPFLAGS) \
    -I$(top_srcdir)/include -I$(top_builddir)/include
gnucap_default_plugins_la_LIBADD = ${APPS_LIBADD}
#------------------------------------------------------------------------
GNUCAP_MODELGEN = $(top_builddir)/modelgen/gnucap-modelgen
#------------------------------------------------------------------------
# some autogenerated headers that are used by others
BUILT_SOURCES += d_mos_base.h d_mos.h d_mos123.h d_diode.h
#------------------------------------------------------------------------
# CLEANFILES += $(MODELS:%.model=%.h) \
#               $(MODELS:%.model=%.cc)
#------------------------------------------------------------------------
#-----------------------------------------------------------------------------
EXTRA_DIST += ${MODELS}
